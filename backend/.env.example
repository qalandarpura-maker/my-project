# Database (PostgreSQL required)
# Local dev ke liye docker-compose.yml me postgres service hai: docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_support"

# Server
PORT=4000
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"
JWT_EXPIRES="7d"

# Owner (seed script pehli baar run hone par ye account banata hai)
OWNER_USERNAME="boss"
OWNER_PASSWORD="REPLACE_WITH_STRONG_OWNER_PASSWORD"
OWNER_NAME="Owner"

# Bot token encryption key (exactly 32 characters)
BOT_TOKEN_SECRET="REPLACE_WITH_EXACTLY_32_CHARACTERS"

# Frontend origin (CORS + Socket.io)
# Multiple origins comma-separated bhi de sakte hain: "http://localhost:5173,https://app.example.com"
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 (S3-compatible) — optional
# Agar R2 env vars missing hain to uploads local disk pe store honge
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="wolf-bots-uploads"
# Public bucket ya public path ke liye — agar set nahi kiya to R2 endpoint URL use hoga
R2_PUBLIC_URL=""