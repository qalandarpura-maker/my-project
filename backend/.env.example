# =============================================================================
# Wolf Bots — Environment Variables
# =============================================================================
# Local dev ke liye .env ki copy banao:  cp .env.example .env
# Production (Render) mein ye sab Render dashboard ke Environment tab mein set karein.
# .env file kabhi bhi GitHub pe push mat karna — ye file sirf example hai.
# =============================================================================

# Database (PostgreSQL required)
# Local dev ke liye docker-compose.yml me postgres service hai: docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_support"

# Server
PORT=4000
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRES="7d"

# Owner (seed script pehli baar run hone par ye account banata hai)
OWNER_USERNAME="boss"
OWNER_PASSWORD="REPLACE_WITH_STRONG_OWNER_PASSWORD"
OWNER_NAME="Owner"

# Bot token encryption key (exactly 32 characters)
BOT_TOKEN_SECRET="REPLACE_WITH_EXACTLY_32_CHARACTERS"

# Frontend origin (CORS + Socket.io)
# Multiple origins comma-separated bhi de sakte hain:
# FRONTEND_URL="http://localhost:5173,https://your-frontend.onrender.com"
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 (S3-compatible) — OPTIONAL for local dev, MANDATORY for Render
# Render ka filesystem ephemeral hai. Bina R2 ke uploaded images/documents
# har redeploy/restart pe delete ho jayenge.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="wolf-bots-uploads"
# Public bucket ya custom public path ke liye. Agar empty hai to R2 endpoint URL use hoga.
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# =============================================================================
# FRONTEND BUILD ENVIRONMENT VARIABLES (Vite)
# Ye frontend build ke waqt chahiye. Render static site ke env vars mein set karein.
# =============================================================================
# VITE_API_URL="https://your-backend.onrender.com"
# VITE_SOCKET_URL="https://your-backend.onrender.com"
