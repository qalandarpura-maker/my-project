generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String // OWNER | ADMIN | AGENT
  createdById  String?
  createdBy    User?    @relation("UserHierarchy", fields: [createdById], references: [id])
  createdUsers User[]   @relation("UserHierarchy")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  bots          Bot[]
  assignedChats Customer[]
}

model Bot {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])
  botTokenEnc  String
  botUsername  String   @unique
  botName      String?
  greeting     String   @default("👋 Assalam o Alaikum! Aap ka message hamari support team ko mil gaya hai. Jald hi iska jawab milega. Shukriya!")
  status       String   @default("active")
  createdAt    DateTime @default(now())

  customers    Customer[]
}

model Customer {
  id              String    @id @default(cuid())
  telegramId      BigInt
  botId           String
  bot             Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  telegramUser    String?
  assignedAgentId String?
  assignedAgent   User?     @relation(fields: [assignedAgentId], references: [id])
  status          String    @default("unassigned") // unassigned | assigned | closed
  lastMessageAt   DateTime  @default(now())
  unreadCount     Int       @default(0)
  createdAt       DateTime  @default(now())

  messages       Message[]

  @@unique([telegramId, botId])
  @@index([assignedAgentId, status])
  @@index([lastMessageAt])
}

model Message {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sender            String   // customer | agent | note
  senderUserId      String?
  text              String
  mediaType         String?  // image | document
  mediaUrl          String?  // /uploads/... or R2 public URL
  telegramMessageId Int?
  createdAt         DateTime @default(now())

  @@index([customerId, createdAt])
}