# Frontend build-time environment variables (Vite)
# Local dev ke liye:  cp .env.example .env
# Render static site ke env vars mein bhi same values set karein.

# Backend API base URL (trailing slash mat lagayen)
VITE_API_URL="http://localhost:4000"

# Socket.io backend URL (usually same as API URL)
VITE_SOCKET_URL="http://localhost:4000"
